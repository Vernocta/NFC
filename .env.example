# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ---- Locale / time ----
# IANA timezone used to compute business days and display times.
TZ_NAME=America/Argentina/Buenos_Aires
# Hours before this local hour count towards the PREVIOUS business day.
# Use 0 for plain calendar days, e.g. 5 if night shifts end at 04:00.
DAY_CUTOFF_HOUR=0
# Kiosk language: es | en
LANG_DEFAULT=es

# ---- Clock rules ----
# Ignore a second scan of the same tag within this many seconds (reader bounce).
SCAN_DEBOUNCE_SECONDS=90
# A shift left open longer than this is auto-closed and flagged for review.
MAX_SHIFT_HOURS=14
# Round each closed shift to this many minutes (0 = no rounding).
ROUND_MINUTES=0
# Unpaid break automatically deducted from shifts longer than BREAK_AFTER_HOURS.
BREAK_MINUTES=0
BREAK_AFTER_HOURS=6

# ---- Security ----
# Token required by every /api/admin route (Bearer header or admin login).
ADMIN_TOKEN=change-me-please
# Optional: if set, kiosks must send this as X-Device-Key when posting a scan.
KIOSK_KEY=

# ---- Dux software integration ----
# Leave DUX_BASE_URL empty to run offline: punches are still recorded and
# queued, and you can export CSV for the liquidación.
#
# Dux's REST base (same for every customer):
#   https://erp.duxsoftware.com.ar/WSERP/rest/services/v2
# Generate the token in Dux, then press "Probar conexión" in Admin -> Dux:
# it calls GET /empresas and prints the id_empresa to paste below.
DUX_BASE_URL=
DUX_API_KEY=
DUX_EMPRESA_ID=
# header | query  -> how the API key travels. Dux uses: Authorization: Bearer
DUX_AUTH_MODE=header
DUX_AUTH_HEADER=Authorization
DUX_AUTH_PREFIX=Bearer
DUX_AUTH_QUERY_PARAM=key
# NOTE: Dux has no attendance endpoint — its API covers the commercial side
# (facturas, clientes, items, gastos), not hours worked. Point this at the
# endpoint you actually want to receive the shifts; leave it empty and use
# the CSV export if the hours are keyed in during the liquidación.
DUX_TIMESHEET_PATH=
DUX_HTTP_METHOD=POST
# Extra static fields merged into every payload (JSON object).
DUX_EXTRA_FIELDS={}
# ---- When the hours are uploaded ----
# daily      -> one batch per day at DUX_DAILY_TIME (default)
# continuous -> each shift is pushed a minute or so after check-out
DUX_SYNC_MODE=daily
# Local wall-clock time of the daily upload, in TZ_NAME.
DUX_DAILY_TIME=17:00
# If the server was off at that hour, upload as soon as it starts again.
DUX_CATCH_UP_ON_START=true
# If a scheduled upload could not drain the queue, retry this often until it
# does, instead of waiting a whole day.
DUX_RETRY_INTERVAL_SECONDS=900
# Only used when DUX_SYNC_MODE=continuous.
DUX_SYNC_INTERVAL_SECONDS=60

# Outbox worker
DUX_SYNC_ENABLED=true
DUX_MAX_ATTEMPTS=8
DUX_TIMEOUT_MS=15000

# Where the daily close writes its CSVs:
#   asistencias_<dia>.csv   detalle de turnos del día (y del día anterior)
#   resumen_<mes>.csv       totales por empleado del mes -> para la liquidación
# Set it to empty to turn the files off.
DAILY_EXPORT_DIR=./data/exports

# ---- Storage ----
DB_PATH=./data/timeclock.db
